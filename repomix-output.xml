    remodelViewTimer();
    // =========================================================

    // 🌟 HELPER: Garantiert die Sichtbarkeit der Top-Stats (Tailwind + natives DOM) 🌟
    function showTopStats() {
        const topStats = document.getElementById('top-stats-container');
