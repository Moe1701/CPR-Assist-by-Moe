/* ==========================================
   1. GRUNDEINSTELLUNGEN & RESET
   ========================================== */
* { -webkit-tap-highlight-color: transparent; }
body { overscroll-behavior-y: none; background-color: #f8fafc; }
.no-select { user-select: none; -webkit-user-select: none; }

/* ==========================================
   2. SCROLLBAR
   ========================================== */
.custom-scrollbar::-webkit-scrollbar { width: 4px; }
.custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
.custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }

/* ==========================================
   3. RESPONSIVES KREIS-MENÜ (Variablen)
   ========================================== */
:root {
    /* MOBILE FIRST (Handys) - SAFE FIBONACCI (Anti-Scroll) */
    --sat-size: 76px;
    --orbit-radius: 160px;   /* 112px (Zentrum) + 10px (Gap) + 38px (Sat) */
    --main-size: 85px;
    --main-x: 125px;         /* Mehr zur Seite geschoben... */
    --main-y: 255px;         /* ...damit Y sicher oben bleibt und nichts abschneidet! */
    --center-btn-size: 224px;
}

@media (min-width: 768px) {
    :root {
        /* iPAD & TABLET - SAFE FIBONACCI */
        --sat-size: 90px;
        --orbit-radius: 177px;   /* 122px (Zentrum) + 10px (Gap) + 45px (Sat) */
        --main-size: 100px;
        --main-x: 140px;
        --main-y: 290px;
        --center-btn-size: 244px;
    }
}

.orbit-path { 
    position: absolute; top: 50%; left: 50%; 
