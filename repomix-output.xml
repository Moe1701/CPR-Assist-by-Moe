                    if (btnAw.dataset.warningLevel !== "extreme") {
                        btnAw.dataset.warningLevel = "extreme";
                        
                        // Alte Klassen aufräumen
                        btnAw.classList.remove('border-slate-100', 'border-amber-400', 'bg-amber-50', 'shadow-[0_0_20px_rgba(245,158,11,0.5)]');
