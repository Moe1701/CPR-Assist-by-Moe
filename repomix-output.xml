            const btnSampler = document.getElementById('btn-rosc-to-sampler');
            const btnLog = document.getElementById('btn-rosc-to-log');
            
            const hitsPanel = document.getElementById('hits-panel');
            const protocolPanel = document.getElementById('protocol-panel');

            if (btnSampler && hitsPanel) {
                btnSampler.addEventListener('click', () => {
                    if (window.CPR && window.CPR.Utils) window.CPR.Utils.vibrate(20);
                    hitsPanel.classList.remove('translate-y-full');
                });
            }

            if (btnLog && protocolPanel) {
                btnLog.addEventListener('click', () => {
                    if (window.CPR && window.CPR.Utils) window.CPR.Utils.vibrate(20);
                    protocolPanel.classList.remove('translate-y-full');
                    if (window.CPR.LogTimeline && typeof window.CPR.LogTimeline.forceRender === 'function') {
